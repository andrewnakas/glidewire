{
 "_styles": "menu = italic bold on transparency (colour from our palette); header = big heavy italic with a vertical gradient; block = upright heavy caps; box = white text on a dark panel with a white frame; plain = upright bold. All wording is Glidewire's own (names.json).",
 "aEndingTextAntonioGusterTex": {"text": "Brass sets the pace.\nEveryone else keeps up.", "style": "box"},
 "aEndingTextBabaTex": {"text": "The river villages will\nsing about this night!", "style": "box"},
 "aEndingTextBeastmanTex": {"text": "GRRR! The trophy is mine,\nand so is the snack bar!", "style": "box"},
 "aEndingTextBillyTex": {"text": "Beep boop! Bongo wins!\nVictory drum solo!", "style": "box"},
 "aEndingTextBioRexTex": {"text": "Quill writes one word\nin the record: first.", "style": "box"},
 "aEndingTextBlackShadowTex": {"text": "The lights go out where\nUmbrage drives.", "style": "box"},
 "aEndingTextBloodFalconTex": {"text": "The copy outran\nthe original.", "style": "box"},
 "aEndingTextCaptainFalconMasterTex": {"text": "Hang up the helmet?\nMaybe next season.", "style": "box"},
 "aEndingTextCaptainFalconStandardExpertTex": {"text": "One more lap,\nthen one more cup.", "style": "box"},
 "aEndingTextDrClashTex": {"text": "Bolt engine mark nine:\nbuilt, tested, triumphant!", "style": "box"},
 "aEndingTextDrStewartTex": {"text": "A steady hand on the\nwheel and the scalpel.", "style": "box"},
 "aEndingTextDraqTex": {"text": "Zirk spins, Zirk wins,\nZirk goes home happy.", "style": "box"},
 "aEndingTextGomarAndShiohTex": {"text": "Pip steers, Pop cheers.\nTeamwork pays off!", "style": "box"},
 "aEndingTextJackLevinTex": {"text": "Signed photos for\neveryone in the stands!", "style": "box"},
 "aEndingTextJamesMcCloudTex": {"text": "Old pilots know\nthe quiet line.", "style": "box"},
 "aEndingTextJodySummerTex": {"text": "Flight school, class of\nfirst place. Next!", "style": "box"},
 "aEndingTextJohnTanakaTex": {"text": "Ken Oda takes the cup\nback to the garage!", "style": "box"},
 "aEndingTextKateAlenTex": {"text": "Sing it loud:\nMira Sol is number one!", "style": "box"},
 "aEndingTextLeonTex": {"text": "Zeph rides the wind\nand the wind says yes.", "style": "box"},
 "aEndingTextMichaelChainTex": {"text": "Cogs turning, wheels\nburning, prize earned.", "style": "box"},
 "aEndingTextMightyGazelleTex": {"text": "Circuits glowing.\nSystems: victorious.", "style": "box"},
 "aEndingTextMrEadTex": {"text": "Gizmo logs the result:\nwin, win and win.", "style": "box"},
 "aEndingTextMrsArrowTex": {"text": "Smooth lines make\nfast laps, dear.", "style": "box"},
 "aEndingTextOctomanTex": {"text": "Grease on my hands,\ngold in my pocket!", "style": "box"},
 "aEndingTextPicoTex": {"text": "Skeff expected a\ntougher crowd.", "style": "box"},
 "aEndingTextRogerBusterTex": {"text": "Lights, camera, podium!\nDuke Rally delivers!", "style": "box"},
 "aEndingTextSamuraiGorohTex": {"text": "The Brand crew eats\nwell tonight!", "style": "box"},
 "aEndingTextSilverNeelsenTex": {"text": "Seventy years young and\nstill the fastest.", "style": "box"},
 "aEndingTextSuperArrowTex": {"text": "Vector clears the track\nfor fair racing!", "style": "box"},
 "aEndingTextTheSkullTex": {"text": "The Hollow King\nclaims his crown.", "style": "box"},
 "aEndingTextZodaTex": {"text": "Kragg breaks records\nand rivals alike!", "style": "box"},
